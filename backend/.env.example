# FocusFlow AI - Backend Environment Configuration Example
# Copy this file to .env and insert your optional API key.
# Note: The frontend runs 100% offline in local demo mode without this backend.

# Groq Cloud API Key (Optional) - https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_placeholder_here

# Model name (default: llama-3.3-70b-versatile or llama-3.1-8b-instant)
MODEL_NAME=llama-3.3-70b-versatile

# Host and Port configuration
PORT=8000
HOST=127.0.0.1
